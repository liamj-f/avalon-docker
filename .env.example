# Copy this file to .env and adjust as needed before running docker compose up.

POSTGRES_USER=avalon
POSTGRES_PASSWORD=change_me
POSTGRES_DB=avalon

# Exposed on the host; visit http://localhost:<FRONTEND_PORT>
FRONTEND_PORT=8080

# Which tag of the published ghcr.io/liamj-f/avalon-docker/{backend,frontend}
# images to pull. Defaults to "latest" (whatever's newest on main); pin to a
# short commit SHA or a v*.*.* release tag for a reproducible deploy.
# IMAGE_TAG=latest

# Only used with docker-compose.proxy-network.yml (see README) -- the name
# of the *external* Docker network your own separate nginx/reverse-proxy
# container is already on.
# PROXY_NETWORK=nginx-proxy
