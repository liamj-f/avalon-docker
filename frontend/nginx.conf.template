server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # REST API
    #
    # BACKEND_HOST/BACKEND_PORT are substituted at container startup (see
    # the Dockerfile's ENV defaults and NGINX_ENVSUBST_FILTER) rather than
    # hardcoded, so this image works regardless of what the backend
    # container/service is actually named or which network alias reaches
    # it -- set them in docker-compose.yml if you rename it away from the
    # default `backend` Compose service name.
    location /api/ {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # uvicorn's ProxyHeadersMiddleware (see backend main.py) reads
        # X-Forwarded-For specifically, not X-Real-IP -- set so the
        # backend's notion of "the client" is correct for logging/fail2ban.
        # $proxy_add_x_forwarded_for (append), not $remote_addr (clobber):
        # if docker-compose.proxy-network.yml is in use and something else
        # is already proxying to this container, that hop's own
        # X-Forwarded-For survives instead of being overwritten -- this
        # nginx's $remote_addr (that outer proxy's IP) is only appended to
        # it. uvicorn walks the whole chain back to the original client.
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # WebSocket (Socket.IO) — long-lived connections, upgrade headers required.
    location /socket.io/ {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 3600s;
    }

    # Docker's healthcheck (docker-compose*.yml) polls this every 10s --
    # a dedicated path rather than reusing `/` means it's never mixed in
    # with real page-load traffic in the access log, so access_log off
    # here silences only the healthcheck spam, not actual visits.
    location = /healthz {
        access_log off;
        return 200;
    }

    # Service worker + manifest (see vite.config.js's VitePWA block) --
    # explicitly uncached so the browser always revalidates before using
    # either, rather than a long-lived HTTP cache delaying players from
    # picking up a new build's "update available" prompt.
    location = /sw.js {
        add_header Cache-Control "no-cache";
    }

    location = /manifest.webmanifest {
        add_header Cache-Control "no-cache";
    }

    # SPA fallback
    location / {
        try_files $uri /index.html;
    }
}
