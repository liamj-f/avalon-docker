# Copy this file to .env and fill in your existing Postgres instance's
# details before running:
#   docker compose -f docker-compose.external-db.yml up --build
#
# The database and role below must already exist on that instance -- see
# the comment at the top of docker-compose.external-db.yml for exactly
# what privileges the role needs.

DB_HOST=postgres.example.internal
DB_PORT=5432

# The pre-existing Avalon database name.
POSTGRES_DB=avalon

# The service account the backend connects as.
POSTGRES_USER=avalon_app
POSTGRES_PASSWORD=change_me

# Exposed on the host; visit http://localhost:<FRONTEND_PORT>
FRONTEND_PORT=8080
